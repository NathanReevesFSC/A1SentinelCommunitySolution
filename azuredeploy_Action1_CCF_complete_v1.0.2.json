                "[resourceId('Microsoft.OperationalInsights/workspaces/tables', parameters('workspace'), variables('tableName'))]"
              ],
              "properties": {
                "connectorUiConfig": {
                  "id": "Action1AuditEventsCCFDefinition",
                  "title": "Action1 Audit Events",
                  "publisher": "Nathan Reeves, Community Project, www.nathanreeves.net",
                  "descriptionMarkdown": "The **Action1 Audit Events** connector collects Action1 Audit Trail records through the Action1 REST API and ingests them into `Action1AuditEvents_CL`.",
                  "graphQueriesTableName": "Action1AuditEvents_CL",
                  "graphQueries": [
                    {
                      "metricName": "Total events received",
                      "legend": "Action1 audit events",
                      "baseQuery": "{{graphQueriesTableName}}"
                    }
                  ],
                  "sampleQueries": [
                    {
                      "description": "Latest Action1 audit events",
                      "query": "{{graphQueriesTableName}}\n| sort by TimeGenerated desc\n| take 50"
                    }
                  ],
                  "dataTypes": [
                    {
                      "name": "{{graphQueriesTableName}}",
                      "lastDataReceivedQuery": "{{graphQueriesTableName}}\n| summarize Time = max(TimeGenerated)\n| where isnotempty(Time)"
                    }
                  ],
                  "connectivityCriteria": [
                    {
                      "type": "HasDataConnectors"
                    }
                  ],
                  "availability": {
                    "status": 1,
                    "isPreview": true
                  },
                  "permissions": {
                    "resourceProvider": [
                      {
                        "provider": "Microsoft.OperationalInsights/workspaces",
                        "permissionsDisplayText": "Read and write permissions are required.",
                        "providerDisplayName": "Workspace",
                        "scope": "Workspace",
                        "requiredPermissions": {
                          "read": true,
                          "write": true,
                          "delete": true
                        }
                      }
                    ],
                    "customs": [
                      {
                        "name": "Action1 API credential",
                        "description": "An Action1 API credential with permission to view the Audit Trail is required."
                      }
                    ]
                  },
                  "instructionSteps": [
                    {
                      "title": "Connect Action1 to Microsoft Sentinel",
                      "description": "Provide the Action1 API base URL, client ID, and client secret, then select Connect.",
                      "instructions": [
                        {
                          "type": "Textbox",
                          "parameters": {
                            "label": "Action1 API base URL",
                            "placeholder": "https://app.action1.com/api/3.0",
                            "type": "text",
                            "name": "urlStub"
                          }
                        },
                        {
                          "type": "Textbox",
                          "parameters": {
                            "label": "Action1 Client ID",
                            "placeholder": "Enter the Action1 client ID",
                            "type": "text",
                            "name": "clientId"
                          }
                        },
                        {
                          "type": "Textbox",
                          "parameters": {
                            "label": "Action1 Client Secret",
                            "placeholder": "Enter the Action1 client secret",
                            "type": "password",
                            "name": "clientSecret"
                          }
                        },
                        {
                          "type": "ConnectionToggleButton",
                          "parameters": {
                            "connectLabel": "Connect",
                            "name": "connect"
                          }
                        }
                      ]
                    }
                  ]
                }
              }
